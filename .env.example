# Examples only. Real secrets belong outside Git, e.g. ~/.samlab-central/credentials.local
# The custom server reads process environment; load the selected credential file before pnpm start.
DATA_DIR=/var/lib/samlab-central
APP_ORIGIN=https://central.example.invalid
ADMIN_USER=operator
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_32_CHAR_OR_LONGER_SECRET
DEVICE_SIGNING_KEY=REPLACE_WITH_UNIQUE_32_CHAR_OR_LONGER_SECRET
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_UNIQUE_32_CHAR_OR_LONGER_SECRET
GITHUB_TOKEN=REPLACE_WITH_OPTIONAL_READ_ONLY_RELEASE_TOKEN
PORT=3022
# Optional, only pnpm dev with a local HTTP origin on port 3022:
LOCAL_ADMIN_AUTH_DISABLED=0
